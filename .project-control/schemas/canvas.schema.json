{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://project-flow.dev/schemas/canvas.schema.json",
  "title": "ProjectFlow Canvas",
  "description": "Visual coordinates, node layouts, and edges for React Flow across project views",
  "type": "object",
  "required": ["version"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string" },
    "viewport": {
      "type": "object",
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "zoom": { "type": "number" }
      }
    },
    "nodes": {
      "type": "array"
    },
    "edges": {
      "type": "array"
    },
    "views": {
      "type": "array"
    }
  }
}
