{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://project-flow.dev/schemas/state.schema.json",
  "title": "ProjectFlow State",
  "description": "Rolling-wave execution state, project proposal, tech stack, completed tasks, and active tasks",
  "type": "object",
  "required": ["version"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string" },
    "initialized": { "type": "boolean" },
    "projectName": { "type": "string" },
    "proposalSummary": { "type": "string" },
    "techStack": {
      "type": ["array", "object"]
    },
    "activeMilestoneId": {
      "type": ["string", "null"]
    },
    "completedTasks": {
      "type": "array"
    },
    "activeTasks": {
      "type": "array"
    },
    "project": {
      "type": "object"
    },
    "completedWorkSummary": {
      "type": "array"
    },
    "activeHorizonTasks": {
      "type": "array"
    }
  }
}
