{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://project-flow.dev/schemas/architecture.schema.json",
  "title": "ProjectFlow Architecture",
  "description": "System modules, API endpoint definitions, data models, and architectural constraints",
  "type": "object",
  "required": ["version"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string" },
    "systemOverview": { "type": "string" },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "layer": { "type": "string" },
          "responsibilities": { "type": "array", "items": { "type": "string" } },
          "dependencies": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "apis": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "moduleId", "name", "endpoint", "method"],
        "properties": {
          "id": { "type": "string" },
          "moduleId": { "type": "string" },
          "milestoneId": { "type": "string" },
          "name": { "type": "string" },
          "endpoint": { "type": "string" },
          "path": { "type": "string" },
          "method": { "type": "string" },
          "description": { "type": "string" },
          "requestPayload": {},
          "request": {},
          "responsePayload": {},
          "response": {}
        }
      }
    },
    "dataModels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "moduleId": { "type": "string" },
          "fields": { "type": "array" }
        }
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "rule"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "category": { "type": "string" },
          "rule": { "type": "string" },
          "severity": { "type": "string" },
          "enforcedBy": { "type": "string" }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source", "target"],
        "properties": {
          "id": { "type": "string" },
          "source": { "type": "string" },
          "target": { "type": "string" },
          "label": { "type": "string" },
          "type": { "type": "string" }
        }
      }
    }
  }
}
