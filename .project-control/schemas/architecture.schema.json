{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vibe-control.dev/schemas/architecture.schema.json",
  "title": "VibeControl Architecture",
  "description": "System modules, API endpoint definitions, data models, and architectural constraints",
  "type": "object",
  "required": ["version", "systemOverview", "modules", "apis", "dataModels", "rules"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string" },
    "systemOverview": { "type": "string" },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "layer", "responsibilities"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "layer": {
            "type": "string",
            "enum": ["core", "cli", "server", "ui", "scanner", "shared"]
          },
          "responsibilities": {
            "type": "array",
            "items": { "type": "string" }
          },
          "dependencies": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "apis": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "moduleId", "name", "endpoint", "method", "description", "responsePayload"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "moduleId": { "type": "string" },
          "name": { "type": "string" },
          "endpoint": {
            "type": "string",
            "pattern": "^/"
          },
          "method": {
            "type": "string",
            "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]
          },
          "description": { "type": "string" },
          "requestPayload": {},
          "responsePayload": {}
        },
        "additionalProperties": false
      }
    },
    "dataModels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "moduleId", "fields"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "moduleId": { "type": "string" },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "type", "required", "description"],
              "properties": {
                "name": { "type": "string" },
                "type": { "type": "string" },
                "required": { "type": "boolean" },
                "description": { "type": "string" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "category", "rule", "severity", "enforcedBy"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "title": { "type": "string" },
          "category": {
            "type": "string",
            "enum": ["data_integrity", "boundaries", "security", "workflow", "performance"]
          },
          "rule": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["error", "warning", "info"]
          },
          "enforcedBy": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
