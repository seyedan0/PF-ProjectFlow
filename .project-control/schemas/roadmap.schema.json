{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vibe-control.dev/schemas/roadmap.schema.json",
  "title": "VibeControl Roadmap",
  "description": "Macro milestones, phases, dependencies, and deliverables tracking",
  "type": "object",
  "required": ["version", "projectId", "projectName", "milestones"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string" },
    "projectId": { "type": "string" },
    "projectName": { "type": "string" },
    "milestones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "description", "targetOutcome", "status", "order"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "targetOutcome": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["planned", "in_progress", "completed", "blocked"]
          },
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "dependencies": {
            "type": "array",
            "items": { "type": "string" }
          },
          "deliverables": {
            "type": "array",
            "items": { "type": "string" }
          },
          "estimatedEffort": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
