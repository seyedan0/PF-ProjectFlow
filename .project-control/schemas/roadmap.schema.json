{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://project-flow.dev/schemas/roadmap.schema.json",
  "title": "ProjectFlow Roadmap",
  "description": "Macro milestones, phases, dependencies, and deliverables tracking",
  "type": "object",
  "required": ["version"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string" },
    "projectId": { "type": "string" },
    "projectName": { "type": "string" },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "targetOutcome": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["planned", "in_progress", "completed", "blocked"]
          },
          "order": { "type": "integer" },
          "dependencies": {
            "type": "array",
            "items": { "type": "string" }
          },
          "deliverables": {
            "type": "array",
            "items": { "type": "string" }
          },
          "estimatedEffort": { "type": "string" }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source", "target"],
        "properties": {
          "id": { "type": "string" },
          "source": { "type": "string" },
          "target": { "type": "string" },
          "label": { "type": "string" },
          "type": { "type": "string" },
          "animated": { "type": "boolean" },
          "style": { "type": "object" }
        }
      }
    }
  }
}
