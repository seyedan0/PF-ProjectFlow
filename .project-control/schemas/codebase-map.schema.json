{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://project-flow.dev/schemas/codebase-map.schema.json",
  "title": "ProjectFlow Codebase Map",
  "description": "Registry of observed files, folders, intended vs observed responsibilities, and module linkages",
  "type": "object",
  "required": ["version"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string" },
    "root": { "type": "string" },
    "layers": {
      "type": "array",
      "items": { "type": "string" }
    },
    "entries": {
      "type": "array"
    },
    "files": {
      "type": "array"
    },
    "dependencies": {
      "type": "array"
    }
  }
}
